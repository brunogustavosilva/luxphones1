# Neon: cole aqui a connection string do banco PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Conta inicial, usada somente ao criar o primeiro administrador no banco.
# Substitua a senha por uma senha forte antes de inicializar produção.
ADMIN_USERNAME=lucasphone2026
ADMIN_PASSWORD=lucasphone2026
# Use ao menos 32 caracteres em produção.
JWT_SECRET=replace-with-a-long-random-secret

PORT=3001
NODE_ENV=development

# Mercado Pago Checkout Pro. Segredos somente no servidor, nunca VITE_*.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# test: exige conta vendedora de teste; production: pagamentos reais.
MP_ENV=test
SITE_URL=http://localhost:5173
# Em localhost deixe em branco. Produção exige URL pública HTTPS e assinatura.
MP_WEBHOOK_URL=
MP_WEBHOOK_SECRET=
