# Neon: cole aqui a connection string do banco PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Conta inicial, usada somente ao criar o primeiro administrador no banco.
# Substitua a senha por uma senha forte antes de inicializar produção.
ADMIN_USERNAME=lucasphone2026
ADMIN_PASSWORD=lucasphone2026
# Use ao menos 32 caracteres em produção.
JWT_SECRET=replace-with-a-long-random-secret

PORT=3001
NODE_ENV=development

# PagBank Checkout hospedado. Segredos somente no servidor, nunca VITE_*.
PAGBANK_ACCESS_TOKEN=
PAGBANK_ENV=sandbox
SITE_URL=http://localhost:5173
# Em localhost deixe em branco; produção exige URL pública HTTPS.
PAGBANK_WEBHOOK_URL=

# Credenciais antigas usadas somente para pedidos Mercado Pago já iniciados.
MP_ACCESS_TOKEN=
MP_ENV=test
MP_WEBHOOK_URL=
MP_WEBHOOK_SECRET=
